[Unit]
Description=OpenHAVoice Voice PE relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/OpenHAVoice
Environment=OPENHAVOICE_CONFIG_PATH=%h/.config/openhavoice/relay.env
EnvironmentFile=%h/.config/openhavoice/relay.env
ExecStart=%h/projects/OpenHAVoice/relay/.venv/bin/python -m relay.relay
Restart=always
RestartSec=5

# Keep logs in the user journal: journalctl --user -u openhavoice-relay -f

[Install]
WantedBy=default.target
