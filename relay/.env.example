# Voice PE device
VOICE_HOST=192.168.50.xxx
VOICE_PSK=base64-noise-psk-from-ha-esphome-config
VOICE_PASSWORD=

# Local services
WHISPER_URL=http://192.168.50.51:8000/v1/audio/transcriptions
ORPHEUS_URL=http://192.168.50.52:5005/v1/audio/speech
ORPHEUS_MODEL=orpheus-german-fix
ORPHEUS_VOICE=jana

# Relay HTTP endpoint used by the Voice PE to fetch synthesized WAV audio
TTS_HOST=0.0.0.0
TTS_PORT=8765
# Grace period before ending the Voice PE assist run after the playback URL was sent.
# Keep short; too long makes the LED look like audio is still playing.
TTS_POST_PLAYBACK_GRACE_SECONDS=1.0

# Capture behavior
LANGUAGE=de
MAX_CAPTURE_SECONDS=15
END_SILENCE_MS=900
MIN_SPEECH_MS=900
# WebRTC VAD aggressiveness: 0 least aggressive, 3 most aggressive.
VAD_AGGRESSIVENESS=2
# Extra loudness-based end-of-speech guard for Voice PE room noise.
RMS_SILENCE_THRESHOLD=500
RMS_END_SILENCE_MS=1200

# Config Web UI/API protection. If empty, /config is localhost-only.
# For LAN access, set a token and send it as Authorization: Bearer <token>.
CONFIG_ADMIN_TOKEN=

# Persistent backend connection / reconnect behavior
RECONNECT_INITIAL_SECONDS=1
RECONNECT_MAX_SECONDS=30

# OpenClaw chat integration
OPENCLAW_URL=http://127.0.0.1:18789
OPENCLAW_TOKEN=
OPENCLAW_MODEL=openclaw/default
# Leave empty for the safe default: openhavoice:<device-name>
OPENCLAW_SESSION_KEY=
OPENCLAW_MESSAGE_CHANNEL=voice
OPENCLAW_VOICE_SYSTEM_PROMPT=Du antwortest als Zoe über einen Voice Assistant. Antworte kurz, natürlich und ohne Markdown, Listen oder Emojis. Ein bis zwei Sätze reichen.
