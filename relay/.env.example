# ── Voice PE ────────────────────────────────────────────────────
# Single Voice PE host/IP fallback when VOICE_DEVICES is empty.
# type: str
VOICE_HOST=

# Noise PSK for the single Voice PE fallback. Secret.
# type: str
VOICE_PSK=

# Optional ESPHome API password for the single-device fallback. Secret.
# type: str
VOICE_PASSWORD=

# Optional JSON list of devices: name, host, psk, password, enabled. Secret.
# type: str
VOICE_DEVICES=


# ── STT (Whisper) ───────────────────────────────────────────────
# Whisper-compatible STT endpoint.
# type: str
WHISPER_URL=http://192.168.50.51:8000/v1/audio/transcriptions

# STT language hint.
# type: str
LANGUAGE=de


# ── TTS (Orpheus) ───────────────────────────────────────────────
# Orpheus/OpenAI-compatible TTS endpoint.
# type: str
ORPHEUS_URL=http://192.168.50.52:5005/v1/audio/speech

# TTS model/deployment name.
# type: str
ORPHEUS_MODEL=orpheus-german-fix-ctx4k

# TTS voice.
# type: str
ORPHEUS_VOICE=jana

# HTTP bind host for generated WAV playback URLs and Web UI.
# type: str
TTS_HOST=0.0.0.0

# HTTP port for generated WAV playback URLs and Web UI.
# type: int
TTS_PORT=8765

# Short grace period before ending the Voice PE assist run after TTS URL handoff.
# type: float
TTS_POST_PLAYBACK_GRACE_SECONDS=1.0


# ── OpenClaw Gateway ────────────────────────────────────────────
# OpenClaw Chat Completions endpoint or gateway base URL.
# type: str
OPENCLAW_URL=http://127.0.0.1:18789

# Optional OpenClaw bearer token. Secret.
# type: str
OPENCLAW_TOKEN=

# Optional fixed session key; empty derives openhavoice:<device-name>.
# type: str
OPENCLAW_SESSION_KEY=

# OpenClaw agent name; stored as a name and sent as openclaw/<agent>.
# type: str
OPENCLAW_AGENT=default

# Message channel header sent to OpenClaw.
# type: str
OPENCLAW_MESSAGE_CHANNEL=voice

# Voice-specific system prompt for concise spoken replies.
# type: str
OPENCLAW_VOICE_SYSTEM_PROMPT=Du antwortest über einen Voice Assistant. Antworte kurz, natürlich und ohne Markdown, Listen oder Emojis. Ein bis zwei Sätze reichen.


# ── VAD / Capture ───────────────────────────────────────────────
# Minimum detected speech before accepting a turn.
# type: int
MIN_SPEECH_MS=900

# WebRTC VAD silence needed to end input.
# type: int
END_SILENCE_MS=900

# Maximum capture length before timeout.
# type: float
MAX_CAPTURE_SECONDS=15.0

# WebRTC VAD aggressiveness, 0-3.
# type: int
VAD_AGGRESSIVENESS=2

# RMS threshold for loudness-based silence guard.
# type: int
RMS_SILENCE_THRESHOLD=500

# Loudness-based silence duration needed to end input.
# type: int
RMS_END_SILENCE_MS=1200


# ── Network / Reconnect ─────────────────────────────────────────
# Initial reconnect backoff for Voice PE connections.
# type: float
RECONNECT_INITIAL_SECONDS=1.0

# Maximum reconnect backoff.
# type: float
RECONNECT_MAX_SECONDS=30.0
